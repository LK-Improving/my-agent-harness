# 复制到根目录 .env 后填写；仅用于本项目隔离开发环境。
# 运行环境：当前为 development（开发）；生产环境必须另行配置正式认证和依赖。
HARNESS_ENVIRONMENT=development
# 开发身份模式，仅允许在 development 环境使用；不是通义 API 的认证方式。
HARNESS_AUTH_MODE=development
# 本项目 M0 测试 PostgreSQL 容器的初始化密码，供 deploy/compose.m0.yaml 使用。
# 应与 HARNESS_TEST_DSN 中的密码保持一致；已有数据卷时，仅修改此值不会更改数据库现有密码。
HARNESS_M0_PG_PASSWORD=
# 隔离 PostgreSQL 测试库连接地址：供 M0 checkpoint、工具回执和提交恢复探针使用，与通义模型无关。
# 格式：postgresql://用户名:密码@主机:端口/数据库名；这里连接本机 15432 端口的 harness_m0 库。
# 15432 映射到本项目容器内的 5432，避免占用其他项目的数据库端口。
# 密码须与 HARNESS_M0_PG_PASSWORD 一致；仅配置此项不会启动数据库或自动运行测试。
HARNESS_TEST_DSN=
# 本项目隔离 Milvus 的访问地址，仅中文检索/索引探针需要；只用聊天模型时无需启动它。
HARNESS_MILVUS_URI=http://127.0.0.1:19531

# 通义千问北京地域；其他地域需要同时调整 API Key 和服务地址。
# 通义 DashScope API Key：在本地填写，不要提交到 Git；留空时不能发起模型调用。
DASHSCOPE_API_KEY=
# 凭据配置的版本化引用名，用于关联配置身份；这里只写引用名，不写 API Key。
QWEN_CREDENTIAL_PROFILE_REF=dashscope-env@1
# 通义聊天与 Embedding 的 OpenAI 兼容接口地址；默认使用北京地域。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 聊天模型名称；模型权限与可用能力尚未进行真实请求验证。
QWEN_CHAT_MODEL=qwen-plus
# 文本向量模型，供知识检索使用；普通聊天不需要调用。当前适配器每批最多10条，调用方显式分批。
QWEN_EMBEDDING_MODEL=text-embedding-v4
# 文本向量维度，必须与 Embedding 模型支持范围及 Milvus 索引维度一致。
QWEN_EMBEDDING_DIMENSIONS=1024
# 检索结果重排模型，用于排序已通过权限校验的候选文档。
QWEN_RERANK_MODEL=gte-rerank-v2
# 通义原生 Rerank 接口地址，与聊天兼容接口路径不同；地域须与 API Key 匹配。
QWEN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 单次通义 HTTP 请求的超时秒数；不代表整个 Agent 运行时限，也不会触发自动重试。
QWEN_TIMEOUT_SECONDS=30
# 单次聊天输出 Token 上限；M0 默认小输出，实际派发还须匹配已准备请求的预算预留。
QWEN_MAX_OUTPUT_TOKENS=128

# M1 正式运行数据库，单独填写本项目专用库；不自动回退 HARNESS_TEST_DSN。
HARNESS_DATABASE_DSN=
# 包含随机 Token 与服务端身份的本地映射；示例见 examples/development-identities.example.json。
HARNESS_DEV_IDENTITY_FILE=.runtime/development-identities.json
# 可选版本化准入策略 JSON；留空使用 development-admission@1。
HARNESS_ADMISSION_PROFILE_FILE=
# 仅 M1 集成测试使用，必须连接本机以 _m1_test 结尾的隔离库；当前可留空。
HARNESS_M1_TEST_DSN=

# M2 独立运营沙箱：默认关闭，不会自动启动服务、建表或派发写工具。
HARNESS_ENABLE_WRITE_SANDBOX=false
# 必须是本机独立 *_write_sandbox 数据库，不能使用 HARNESS_DATABASE_DSN 或 HARNESS_TEST_DSN。
HARNESS_SANDBOX_DSN=
# 至少32字符的独立随机访问Token，仅供本地运营沙箱；请勿提交或在聊天中发送。
HARNESS_SANDBOX_TOKEN=
# 沙箱仅允许本机HTTP服务，默认端口18081；启用前需显式启动独立服务。
HARNESS_SANDBOX_BASE_URL=http://127.0.0.1:18081

# M1/M2 实际执行profile；留空使用 examples/execution-profile.example.json 的安全默认值。
# 模型能力默认未验证，不能因此发起真实请求；确认能力/窗口后在本地.profile副本中填写。
HARNESS_EXECUTION_PROFILE_FILE=
# 核心开发PG容器的独立密码，仅 deploy/compose.core.yaml 使用；不会自动填充业务DSN。
HARNESS_CORE_PG_PASSWORD=
# 可选本机控制命令Token；对应本地身份文件中的操作者，留空时终端隐藏输入。
# 注册候选需要release_admin；进程恢复需要独立recovery_operator及harness:recovery:local范围。
HARNESS_OPERATOR_TOKEN=

# 新提供商配置显式入口；留空继续旧通义路径。示例见examples/model-providers.example.json。
HARNESS_MODEL_PROVIDERS_FILE=

# 启用新入口时必填：可信能力证据/撤销清单；示例为空，不可派发，不能自填已验证冒充实测。
HARNESS_MODEL_EVIDENCE_FILE=

# 可选本地非秘密账户引用映射；默认已有dashscope-env@1与deepseek-env@1，额外账户示例见model-credentials.example.json。
HARNESS_MODEL_CREDENTIALS_FILE=

# 仅选中DeepSeek时读取；密钥留本地，不填也不影响默认通义，当前不发起真实验证。
DEEPSEEK_API_KEY=

# M3-07检索模型独立配置；仅服务端显式启用RAG后读取，不改变聊天入口或core就绪条件。
# 示例含固定连接/profile但不含可信证据；不会因为填写路径或密钥自动启用。
HARNESS_RETRIEVAL_MODELS_FILE=
# 检索专用能力证据/撤销清单；依据已有实测审查登记，不自填“已验证”或自动重复探针。
HARNESS_RETRIEVAL_EVIDENCE_FILE=

# M3-01受限入库CLI；默认关闭，不影响core，不自动迁移/上传/连接供应商。
HARNESS_RAG_ENABLED=false
# 本地副本只定义暂存/原文目录与有界解析profile；身份沿用服务端Token映射。
HARNESS_INGESTION_CONFIG_FILE=

# M3-02显式构建/快照CLI；只在build读取此文件与Milvus凭据，不自动连接/构建。
HARNESS_INDEX_CONFIG_FILE=
# 可选Milvus认证Token；仅本项目选中端点使用，不进入manifest/日志。
HARNESS_MILVUS_TOKEN=

# M3-03固定快照检索profile/pin；显式可选组合根读取，不自动查询或改动run manifest。
HARNESS_RETRIEVAL_PIPELINE_FILE=

# M3-04装配选择：operations默认只用core；travel需显式RAG配置与已发布知识pin。
HARNESS_AGENT_PROFILE=operations
